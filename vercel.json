{
  "redirects": [
    {
      "source": "/portfolio-collections/:path*",
      "destination": "/impressies",
      "permanent": true
    },
    {
      "source": "/_frog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/promotieartikelen-en-merchandise",
      "destination": "/producten",
      "permanent": true
    },
    {
      "source": "/diensten",
      "destination": "/producten",
      "permanent": true
    },
    {
      "source": "/kleding",
      "destination": "/producten",
      "permanent": true
    },
    {
      "source": "/offerte-aanvragen",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt",  "destination": "/robots.txt"  },
    { "source": "/(.*)",        "destination": "/index.html"  }
  ]
}
